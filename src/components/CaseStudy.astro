---
const { cs, headingTag = 'h3', showPermalink = true } = Astro.props;
const Heading = headingTag;

const escapeHtml = str => str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const linkify = str => escapeHtml(str).replace(
  /(https?:\/\/[^\s)]+)/g,
  url => `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`
);
---

<article class="case-study" id={cs.slug}>
  <Heading>{cs.title}</Heading>
  <p class="case-meta">
    <span class="meta-badge">{cs.period}</span>
    <span class="meta-badge">{cs.role}</span>
    <span class="meta-badge">{cs.tags}</span>
  </p>
  <p><strong>The problem.</strong> <span set:html={linkify(cs.problem)} /></p>
  <p><strong>What I did.</strong> <span set:html={linkify(cs.whatIDid)} /></p>
  <p><strong>The outcome.</strong> <span set:html={linkify(cs.outcome)} /></p>
  {cs.links.length > 0 && (
    <p class="item-links">
      {cs.links.map(l => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}</a>)}
    </p>
  )}
  {showPermalink && (
    <p class="permalink"><a href={`/portfolio/${cs.slug}`}>Permalink to this case study →</a></p>
  )}
</article>

<style>
  .case-study {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-light);
  }

  .case-study:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .case-study h1,
  .case-study h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.5rem;
  }

  .case-study h1 {
    font-size: 1.75rem;
  }

  .case-meta {
    margin-bottom: 1rem;
  }

  .meta-badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--color-gray-medium);
    background: var(--color-gray-light);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    margin: 0 0.4rem 0.4rem 0;
  }

  .case-study p {
    margin-bottom: 0.9rem;
    line-height: 1.6;
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }

  .item-links a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-turquoise);
  }

  .item-links a:hover {
    color: var(--color-magenta);
    text-decoration: underline;
  }

  .permalink {
    margin-top: 0.5rem;
  }

  .permalink a {
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .case-study h1,
    .case-study h3 {
      font-size: 1.1rem;
    }

    .case-study h1 {
      font-size: 1.4rem;
    }
  }
</style>
