---
import Layout from '../layouts/Layout.astro';
import { Image, Picture } from 'astro:assets';
import profileImage from '../../public/profile.jpg';

import wtd26 from '../assets/photos/WTD26-berlin-speakers-jazz-medium-res.jpg';
import wtd26Sketchnote from '../assets/photos/WTD26-berlin-sketchnote.jpg';
import scbcn25 from '../assets/photos/SCBCN25 - Documenting APIs.jpeg';
import scbcn24 from '../assets/photos/SCBCN24 - AI in Support teams.jpeg';
import scbcn23 from '../assets/photos/SCBCN23 - We\'re capitalists.jpeg';
import scbcn22 from '../assets/photos/SCBCN22 - NoMeetings Open Space.jpeg';
import cas22Graphic from '../assets/photos/CAS22 - NoMeetings - w graphic recorder.jpeg';
import cas22 from '../assets/photos/CAS22 - NoMeetings.jpeg';
import aos23 from '../assets/photos/AOS23 - Event organizers.jpeg';


import speakingData from '../data/speaking.json';

const { talks, workshops, media, communities } = speakingData;

const getYear = d => new Date(d).getFullYear();
---

<Layout title="Javi Rubio">
  <div class="content-container">

    <section class="hero">
      <div class="hero-header">
        <div>
          <h1>Javi Rubio</h1>
          <p class="typed-roles"><span id="typed-role"></span></p>
          <p class="subtitle">Helping teams build better products, knowledge systems, and sustainable work cultures.</p>
        </div>
        <Image src={profileImage} alt="Javi Rubio" class="profile-photo" width={200} height={200} />
      </div>
    </section>

    <section class="about">
      <p class="intro">
        Generalist software engineer with techno-activist leanings. 20 years working at the intersection of product, engineering, and knowledge management.
      </p>
      <p class="intro">
        I've been part of startups from day one, served as CTO, and led complex technical products. Known for championing <a href="https://nomeetings.work" target="_blank" rel="noopener noreferrer"><strong>#NoMeetings</strong></a>, helping distributed teams rethink collaboration beyond default rituals.
      </p>
      <p class="intro">
        Available for speaking at tech conferences and corporate events. <a href="#contact">Get in touch →</a>
      </p>
    </section>

    <section id="speaking" class="speaking-section">
      <h2>Public Speaking &amp; Tech Communities</h2>
      <p class="section-intro">I regularly speak at tech conferences and corporate events, facilitate trainings and workshops, and collaborate with different tech communities.</p>

      <div class="photo-carousel">
        <div aria-hidden="true">
          <div class="photo-slide landscape" data-full={wtd26.src}>
            <Picture src={wtd26} alt="Speaking at WTD26" widths={[360, 720]} sizes="360px" formats={['avif', 'webp']} />
            <span class="photo-caption">WTD26 - Documenting APIs: new era, same craft</span>
          </div>
          <div class="photo-slide portrait contain" data-full={wtd26Sketchnote.src}>
            <Picture src={wtd26Sketchnote} alt="Sketchnote of the WTD26 talk by Dennis Dawson" widths={[280, 560]} sizes="280px" formats={['avif', 'webp']} />
            <span class="photo-caption">WTD26 - Sketchnote by Dennis Dawson</span>
          </div>
          <div class="photo-slide landscape" data-full={scbcn25.src}>
            <Picture src={scbcn25} alt="Speaking at SCBCN25" widths={[360, 720]} sizes="360px" formats={['avif', 'webp']} />
            <span class="photo-caption">SCBCN25 - Documenting APIs</span>
          </div>
          <div class="photo-slide portrait" data-full={scbcn24.src}>
            <Picture src={scbcn24} alt="Speaking at SCBCN24" widths={[280, 560]} sizes="280px" formats={['avif', 'webp']} />
            <span class="photo-caption">SCBCN24 - AI in Support teams</span>
          </div>
          <div class="photo-slide landscape" data-full={scbcn23.src}>
            <Picture src={scbcn23} alt="Speaking at SCBCN23" widths={[360, 720]} sizes="360px" formats={['avif', 'webp']} />
            <span class="photo-caption">SCBCN23 - We're capitalists</span>
          </div>
          <div class="photo-slide portrait" data-full={scbcn22.src}>
            <Picture src={scbcn22} alt="Speaking at SCBCN22" widths={[280, 560]} sizes="280px" formats={['avif', 'webp']} />
            <span class="photo-caption">SCBCN22 - NoMeetings Open Space</span>
          </div>
          <div class="photo-slide portrait" data-full={cas22Graphic.src}>
            <Picture src={cas22Graphic} alt="Speaking at CAS22" widths={[280, 560]} sizes="280px" formats={['avif', 'webp']} />
            <span class="photo-caption">CAS22 - NoMeetings & bgcampa</span>
          </div>
          <div class="photo-slide landscape" data-full={cas22.src}>
            <Picture src={cas22} alt="Speaking at CAS22" widths={[360, 720]} sizes="360px" formats={['avif', 'webp']} />
            <span class="photo-caption">CAS22 - NoMeetings</span>
          </div>
          <div class="photo-slide portrait" data-full={aos23.src}>
            <Picture src={aos23} alt="AOS23 event organizers" widths={[280, 560]} sizes="280px" formats={['avif', 'webp']} />
            <span class="photo-caption">AOS23 - Event organizers</span>
          </div>
        </div>
        <button type="button" class="photo-enlarge" aria-label="Enlarge photo"></button>
      </div>

      <dialog class="lightbox">
        <img alt="" />
        <p class="lightbox-caption"></p>
        <button type="button" class="lightbox-nav lightbox-prev" data-step="-1" aria-label="Previous photo">‹</button>
        <button type="button" class="lightbox-nav lightbox-next" data-step="1" aria-label="Next photo">›</button>
        <form method="dialog"><button class="lightbox-close" aria-label="Close">×</button></form>
      </dialog>

      <div class="subsection">
        <h3>Tech Conference Talks</h3>
        <ul class="talks-list-inline">
          {talks.map(talk => (
                  <li class="talk"
                      data-section={!talk.featured ? 'talks' : undefined}
                      style={!talk.featured ? 'display:none' : undefined}>
                    <strong>{talk.title}</strong>
                    <p class="talk-meta">{talk.event} · {getYear(talk.date)}</p>
                    <div class="item-footer">
                      {talk.description && (
                        <details class="item-description">
                          <summary>About this talk</summary>
                          <p>{talk.description}</p>
                        </details>
                      )}
                      {talk.description && (talk.video || talk.slides || talk.links?.length > 0) && (
                        <span class="item-sep" aria-hidden="true">·</span>
                      )}
                      {(talk.video || talk.slides || talk.links?.length > 0) && (
                        <span class="item-links">
                          {talk.video && <a href={talk.video} target="_blank" rel="noopener noreferrer">📹 Video</a>}
                          {talk.slides && <a href={talk.slides} target="_blank" rel="noopener noreferrer">🖼️ Slides</a>}
                          {talk.links?.map(l => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}</a>)}
                        </span>
                      )}
                    </div>
                  </li>
                ))
          }
        </ul>
        {talks.some(t => !t.featured) && (
          <button class="show-toggle" data-toggle data-section="talks"
            data-total={talks.length} data-label="talks">
            Show all {talks.length} talks
          </button>
        )}
      </div>

      <div class="subsection">
        <h3>Workshops &amp; Facilitation</h3>
        <ul class="talks-list-inline">
          {workshops.map(item => (
                  <li class="talk"
                      data-section={!item.featured ? 'workshops' : undefined}
                      style={!item.featured ? 'display:none' : undefined}>
                    <strong>{item.title}</strong>
                    <p class="talk-meta">{item.event} · {getYear(item.date)}</p>
                    <div class="item-footer">
                      {item.description && (
                        <details class="item-description">
                          <summary>About this workshop</summary>
                          <p>{item.description}</p>
                        </details>
                      )}
                      {item.description && (item.video || item.slides || item.links.length > 0) && (
                        <span class="item-sep" aria-hidden="true">·</span>
                      )}
                      {(item.video || item.slides || item.links.length > 0) && (
                        <span class="item-links">
                          {item.video && <a href={item.video} target="_blank" rel="noopener noreferrer">📹 Video</a>}
                          {item.slides && <a href={item.slides} target="_blank" rel="noopener noreferrer">🖼️ Slides</a>}
                          {item.links.map(l => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}</a>)}
                        </span>
                      )}
                    </div>
                  </li>
                ))
          }
        </ul>
        {workshops.some(i => !i.featured) && (
          <button class="show-toggle" data-toggle data-section="workshops"
            data-total={workshops.length} data-label="workshops">
            Show all {workshops.length} workshops
          </button>
        )}
      </div>

      <div class="subsection">
        <h3>Podcasts &amp; Radio interviews</h3>
        <ul class="talks-list-inline">
          {media.map(item => (
                  <li class="talk"
                      data-section={!item.featured ? 'media' : undefined}
                      style={!item.featured ? 'display:none' : undefined}>
                    <strong>{item.title}</strong>
                    <p class="talk-meta">{item.event} · {getYear(item.date)}</p>
                    <div class="item-footer">
                      {item.description && (
                        <details class="item-description">
                          <summary>About this episode</summary>
                          <p>{item.description}</p>
                        </details>
                      )}
                      {item.description && item.links.length > 0 && (
                        <span class="item-sep" aria-hidden="true">·</span>
                      )}
                      {item.links.length > 0 && (
                        <span class="item-links">
                          {item.links.map(l => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}</a>)}
                        </span>
                      )}
                    </div>
                  </li>
                ))
          }
        </ul>
        {media.some(i => !i.featured) && (
          <button class="show-toggle" data-toggle data-section="media"
            data-total={media.length} data-label="items">
            Show all {media.length} items
          </button>
        )}
      </div>

      <div class="subsection">
        <h3>Tech Communities</h3>
        <ul class="talks-list-inline">
          {communities.map(item => (
                  <li class="talk"
                      data-section={!item.featured ? 'community' : undefined}
                      style={!item.featured ? 'display:none' : undefined}>
                    <strong>
                      {item.website
                        ? <a href={item.website} target="_blank" rel="noopener noreferrer">{item.title}</a>
                        : item.title}
                    </strong>
                    <p class="talk-meta">{item.role} · {item.period} · {item.location}</p>
                    <div class="item-footer">
                      {item.description && (
                        <details class="item-description">
                          <summary>About this</summary>
                          <p>{item.description}</p>
                        </details>
                      )}
                      {item.description && item.links.length > 0 && (
                        <span class="item-sep" aria-hidden="true">·</span>
                      )}
                      {item.links.length > 0 && (
                        <span class="item-links">
                          {item.links.map(l => (
                            <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}</a>
                          ))}
                        </span>
                      )}
                    </div>
                    {item.activities.length > 0 && (
                      <ul class="activities-list">
                        {item.activities.map(act => (
                          <li>
                            {act.link
                              ? <a href={act.link} target="_blank" rel="noopener noreferrer">{act.title}</a>
                              : act.title}
                            {act.date ? ` · ${getYear(act.date)}` : ''}
                            {` · ${act.role}`}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
          }
        </ul>
        {communities.some(i => !i.featured) && (
          <button class="show-toggle" data-toggle data-section="community"
            data-total={communities.length}
            data-label="items"
          >
            Show all {communities.length} items
          </button>
        )}
      </div>

    </section>
  </div>

</Layout>

<script>
  import Typed from 'typed.js';

  new Typed('#typed-role', {
    strings: [
      'Tech Writer',
      'Developer Relations',
      'Chief Technical Officer',
      'Associate Professor',
      'Android Dev',
      'Technical Coach',
      'Technical Product Manager',
      'Product Engineer',
    ],
    typeSpeed: 60,
    backSpeed: 30,
    backDelay: 1600,
    loop: true,
    showCursor: true,
    cursorChar: '|',
    shuffle: true,
  });

  // Show/hide subsection items (hidden via inline style on load)
  document.querySelectorAll('[data-toggle]').forEach(btn => {
    const section = (btn as HTMLElement).dataset.section;
    const label = (btn as HTMLElement).dataset.label;
    const total = (btn as HTMLElement).dataset.total;

    btn.addEventListener('click', () => {
      const isExpanded = (btn as HTMLElement).dataset.expanded === 'true';
      document.querySelectorAll(`li[data-section="${section}"]`).forEach(item => {
        (item as HTMLElement).style.display = isExpanded ? 'none' : '';
      });
      (btn as HTMLElement).dataset.expanded = isExpanded ? 'false' : 'true';
      btn.textContent = isExpanded ? `Show all ${total} ${label}` : 'Show less';
    });
  });

  const lightbox = document.querySelector('.lightbox');
  const lightboxImg = lightbox.querySelector('img');
  const lightboxCaption = lightbox.querySelector('.lightbox-caption');
  const slides = [...document.querySelectorAll('.photo-slide')];
  const opacity = el => Number(getComputedStyle(el).opacity);
  let current = 0;

  // Wraps around at both ends
  function showSlide(index) {
    current = (index + slides.length) % slides.length;
    const slide = slides[current];
    lightboxImg.src = slide.dataset.full;
    lightboxImg.alt = slide.querySelector('img').alt;
    lightboxCaption.textContent = slide.querySelector('.photo-caption').textContent;
  }

  // Slides crossfade in CSS, so the photo to enlarge is the most visible one at click time
  document.querySelector('.photo-enlarge').addEventListener('click', () => {
    showSlide(slides.reduce((best, slide, i) => opacity(slide) > opacity(slides[best]) ? i : best, 0));
    lightbox.showModal();
  });

  lightbox.querySelectorAll('[data-step]').forEach(btn => {
    btn.addEventListener('click', () => showSlide(current + Number(btn.dataset.step)));
  });

  lightbox.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') showSlide(current - 1);
    if (e.key === 'ArrowRight') showSlide(current + 1);
  });

  let touchStartX = 0;
  lightbox.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; });
  lightbox.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) showSlide(current + (dx < 0 ? 1 : -1));
  });

  // Clicks on the backdrop land on the dialog itself
  lightbox.addEventListener('click', e => {
    if (e.target === lightbox) lightbox.close();
  });
</script>

<style>
  .hero {
    text-align: left;
  }

  .hero-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .profile-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    animation: fadeIn 0.8s ease-in;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .typed-roles {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-magenta);
    min-height: 2rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-black);
  }

  :global(.typed-cursor) {
    color: var(--color-magenta);
    font-weight: 300;
  }

  .speaking-section {
    max-width: 1200px;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-light);
  }

  /* Clearfix for carousel float */
  .speaking-section::after {
    content: "";
    display: table;
    clear: both;
  }

  .speaking-section h2 {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
  }

  .section-intro {
    font-size: 1.05rem;
    color: var(--color-black);
    margin-bottom: 1.5rem;
  }

  .photo-carousel {
    float: right;
    width: 360px;
    height: 360px;
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }

  .photo-slide {
    position: absolute;
    opacity: 0;
    animation: fadeSlide 36s infinite;
    border-radius: 12px;
    overflow: hidden;
  }

  /* Let people look at a photo without it changing; resumes where it left off */
  .photo-carousel:hover .photo-slide,
  .photo-carousel:focus-within .photo-slide {
    animation-play-state: paused;
  }

  .photo-slide.portrait {
    width: 280px;
    height: 360px;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .photo-slide.landscape {
    width: 360px;
    height: 230px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .photo-slide:nth-child(1) { animation-delay: 0s; }
  .photo-slide:nth-child(2) { animation-delay: 4s; }
  .photo-slide:nth-child(3) { animation-delay: 8s; }
  .photo-slide:nth-child(4) { animation-delay: 12s; }
  .photo-slide:nth-child(5) { animation-delay: 16s; }
  .photo-slide:nth-child(6) { animation-delay: 20s; }
  .photo-slide:nth-child(7) { animation-delay: 24s; }
  .photo-slide:nth-child(8) { animation-delay: 28s; }
  .photo-slide:nth-child(9) { animation-delay: 32s; }

  .photo-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Drawings must be seen whole, not cropped */
  .photo-slide.contain img {
    object-fit: contain;
    background: var(--color-gray-light);
  }

  .photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.75rem;
    color: var(--color-gray-medium);
    background: rgba(255, 255, 255, 0.85);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Percentages of the 36s cycle: ~4s per slide with a short crossfade */
  .photo-enlarge {
    position: absolute;
    inset: 0;
    background: none;
    border: 0;
    cursor: zoom-in;
  }

  .photo-enlarge:focus-visible {
    outline: 2px solid var(--color-magenta);
    outline-offset: -2px;
    border-radius: 12px;
  }

  .lightbox {
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    max-width: 95vw;
    max-height: 95vh;
  }

  .lightbox::backdrop {
    background: rgba(26, 26, 26, 0.9);
  }

  .lightbox img {
    display: block;
    max-width: 95vw;
    max-height: 85vh;
    object-fit: contain;
  }

  .lightbox-caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-white);
    text-align: center;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgba(26, 26, 26, 0.6);
    color: var(--color-white);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev { left: 0.5rem; }
  .lightbox-next { right: 0.5rem; }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: var(--color-magenta);
  }

  @keyframes fadeSlide {
    0%     { opacity: 0; }
    1.8%   { opacity: 1; }
    10.7%  { opacity: 1; }
    12.4%  { opacity: 0; }
    100%   { opacity: 0; }
  }

  .subsection {
    margin-top: 3rem;
  }

  .subsection h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-black);
    border-bottom: 1px solid var(--color-gray-light);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .talks-list-inline {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .talk > strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .talk-meta {
    font-size: 0.9rem;
    color: var(--color-gray-medium);
    margin-top: 0.1rem;
  }

  .item-footer {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }

  .item-sep {
    color: var(--color-gray-medium);
    font-size: 0.85rem;
    user-select: none;
  }

  .item-description {
    font-size: 0.85rem;
  }

  .item-description summary {
    list-style: none;
    color: var(--color-turquoise);
    cursor: pointer;
    user-select: none;
  }

  .item-description summary::-webkit-details-marker {
    display: none;
  }

  .item-description summary::before {
    content: "▸ ";
  }

  details.item-description[open] > summary::before {
    content: "▾ ";
  }

  .item-description p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-gray-medium);
    line-height: 1.5;
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .item-links a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-turquoise);
  }

  .item-links a:hover {
    color: var(--color-magenta);
    text-decoration: underline;
  }

  .activities-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.9rem;
    color: var(--color-gray-medium);
  }

  .show-toggle {
    margin-top: 1rem;
    background: none;
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    color: var(--color-turquoise);
    font-size: 0.85rem;
    font-family: inherit;
  }

  .show-toggle:hover {
    color: var(--color-magenta);
  }

  @media (max-width: 768px) {
    .hero-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 1rem;
    }

    .profile-photo {
      width: 150px;
      height: 150px;
      order: -1;
    }

    .typed-roles,
    .subtitle {
      font-size: 1.1rem;
    }

    .photo-carousel {
      float: none;
      width: 100%;
      height: 240px;
      margin: 0 0 1.5rem 0;
      border-radius: 8px;
    }

    .photo-slide.portrait,
    .photo-slide.landscape {
      width: 100%;
      height: 240px;
      top: 0;
      left: 0;
      transform: none;
    }
  }
</style>
